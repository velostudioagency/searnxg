# Optional environment overrides (all can also be changed in the Settings UI).
# Copy to backend/.env — values here override the saved settings.json at startup.

# Your own SearXNG instance (leave empty to use the built-in sources only)
SEARXNG_URL=http://localhost:8080
SEARXNG_API_KEY=

# Comma-separated list of keys accepted by /api/search and /api/extract
API_KEYS=sk-example-key-1,sk-example-key-2

# Protects /api/settings and /api/keys (X-Admin-Key header)
ADMIN_KEY=change-me

# Set to true to require an API key on /api/search and /api/extract
REQUIRE_API_KEY=false

DEFAULT_LIMIT=10
TIMEOUT=12
